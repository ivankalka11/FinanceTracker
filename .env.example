# Finance Tracker secrets: single source for TelegramBot and Dashboard.
# DO NOT COMMIT. After editing, run: python scripts/build_dashboard_config.py

# --- Shared: Apps Script backend (used by bot AND dashboard) ---
APPS_SCRIPT_URL=
API_SECRET=

# --- Supabase (V2 default database) ---
# URL + publishable key are safe in the browser (row-level security protects the data).
# The secret key bypasses security: server-side scripts only, never in the dashboard.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Telegram bot ---
BOT_TOKEN=
ALLOWED_TELEGRAM_ID=

# --- Receipt OCR ---
OCR_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=

# --- Market data ---
EMAS_API_KEY=

# --- Hosting (Cloudflare Pages) ---
# Your own project name; the app is served at https://<name>.pages.dev
# Lowercase letters, numbers and dashes only.
CLOUDFLARE_PAGES_PROJECT=

# --- Telegram webhook (V2 phase 4) ---
# Leave empty: scripts/setup_telegram_webhook.py creates it in .env.
TELEGRAM_WEBHOOK_SECRET=
# The project's production branch in Cloudflare (default: main). Uploads to any
# other branch only reach a preview address.
CLOUDFLARE_PAGES_BRANCH=
