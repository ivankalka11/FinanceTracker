# Cloudflare Pages response headers for the PWA.
# The policy allows only what the app uses: its own files, the two pinned
# libraries on jsDelivr (plus the on-device OCR engine, which needs WebAssembly),
# Google Fonts, and the Supabase project.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://cdn.jsdelivr.net https://fonts.googleapis.com https://fonts.gstatic.com; worker-src 'self' https://cdn.jsdelivr.net; manifest-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin

# connect-src names every Supabase project (https://*.supabase.co). scripts/deploy_pwa.py swaps that
# for your own project's host in the uploaded copy, so the repo never holds the project address.

# Phones must always re-check these so a new release is picked up.
/sw.js
  Cache-Control: no-cache
/config.js
  Cache-Control: no-cache
